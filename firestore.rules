rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------
       AUTH HELPERS
    --------------------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function isActive() {
      return userDoc().data.active == true;
    }

    function isAdmin() {
      return signedIn() && isActive() && role() == "admin";
    }

    function isManager() {
      return signedIn() && isActive() && role() == "manager";
    }

    function isAdvisor() {
      return signedIn() && isActive() && role() == "advisor";
    }

    function isWash() {
      return signedIn() && isActive() && role() == "wash";
    }

    function isstaff() {
      return signedIn() && isActive() && role() == "staff";
    }

    function isStaff() {
      return isstaff();
    }

    function isBooker() {
      return signedIn() && isActive() && role() == "booker";
    }

    function isQc() {
      return signedIn() && isActive() && role() == "qc";
    }

    function isValet() {
      return signedIn() && isActive() && role() == "valet";
    }

    function isEmployee() {
      return isAdmin()
        || isManager()
        || isAdvisor()
        || isWash()
        || isStaff()
        || isValet()
        || isBooker()
        || isQc();
    }

    function onlyChanges(allowedKeys) {
      return request.resource.data
        .diff(resource.data)
        .changedKeys()
        .hasOnly(allowedKeys);
    }

    function canControlWashDay() {
      return isAdmin()
        || isManager()
        || (signedIn() && isActive() && userDoc().data.permissions.canControlWashDay == true);
    }

    function canEditTickets() {
      return signedIn()
        && isActive()
        && userDoc().data.permissions.canEditTickets == true;
    }

    function canFixTag() {
      return canEditTickets()
        && userDoc().data.permissions.corrections.tag == true;
    }

    function canFixRo() {
      return canEditTickets()
        && userDoc().data.permissions.corrections.ro == true;
    }

    function canFixLocation() {
      return canEditTickets()
        && userDoc().data.permissions.corrections.location == true;
    }

    function canFixAdvisorNumber() {
      return canEditTickets()
        && userDoc().data.permissions.corrections.advisorNumber == true;
    }

    function isArrowDev() {
      return signedIn()
        && exists(/databases/$(database)/documents/arrowdevUsers/$(request.auth.uid));
    }

    /* ---------------------------------------
       USERS COLLECTION
    --------------------------------------- */

    match /users/{uid} {

      allow list: if isAdmin() || isManager() || isBooker() || isAdvisor();

      allow get: if
        (signedIn() && request.auth.uid == uid)
        || isAdmin()
        || isManager();

      allow create: if
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == "pending"
        && request.resource.data.active == true;

      allow update: if
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active;

      allow update: if
        isManager()
        && uid != request.auth.uid
        && request.resource.data.role in [
          "manager",
          "advisor",
          "wash",
          "staff",
          "valet",
          "booker",
          "qc",
          "pending"
        ]
        && request.resource.data.role != "admin";

      allow update: if
        (isAdmin() || isManager())
        && uid != request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["permissions", "updatedAt"])
        && request.resource.data.permissions is map
        && request.resource.data.permissions.keys().hasOnly([
          "canControlWashDay",
          "canEditTickets",
          "corrections"
        ])
        && request.resource.data.permissions.canControlWashDay is bool
        && request.resource.data.permissions.canEditTickets is bool
        && request.resource.data.permissions.corrections is map
        && request.resource.data.permissions.corrections.keys().hasOnly([
          "tag",
          "ro",
          "location",
          "advisorNumber"
        ])
        && request.resource.data.permissions.corrections.tag is bool
        && request.resource.data.permissions.corrections.ro is bool
        && request.resource.data.permissions.corrections.location is bool
        && request.resource.data.permissions.corrections.advisorNumber is bool;

      allow update: if isAdmin();

      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    /* ---------------------------------------
       WASH TICKETS COLLECTION
    --------------------------------------- */

    match /washTickets/{ticketId} {

      allow read: if isEmployee();
      allow create: if isEmployee();

      allow update: if isAdmin() || isManager();

      allow update: if canFixTag()
        && onlyChanges([
          "tag",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ]);

      allow update: if canFixRo()
        && onlyChanges([
          "ro",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ]);

      allow update: if canFixLocation()
        && onlyChanges([
          "location",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ]);

      allow update: if canFixAdvisorNumber()
        && onlyChanges([
          "advisorNumber",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ]);

      allow update: if isWash()
        && onlyChanges([
          "status",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",
          "washingStartedAt",
          "washingStartedAtMs",
          "washingStartedBy",
          "washedAt",
          "washedAtMs",
          "washedBy",
          "washCount",
          "rewashCount",
          "priorityType",
          "isRewashCycle",
          "rewashRequestedAtMs",
          "rewashRequestedBy",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields",
          "events",
          "scheduledAtMs",
          "scheduledEndAtMs",
          "scheduledBay",
          "scheduleRisk",
          "scheduleUpdatedAtMs"
        ]);

      allow update: if isAdvisor()
        && onlyChanges([
          "priorityType",
          "needByAtMs",
          "needBySetBy",
          "ro",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);

      allow update: if isAdvisor()
        && resource.data.status == "washed"
        && request.resource.data.status == "queued"
        && request.resource.data.rewashRequestedBy == request.auth.uid
        && request.resource.data.rewashRequestedAtMs is int
        && request.resource.data.priorityType == "rewash"
        && request.resource.data.isRewashCycle == true
        && onlyChanges([
          "status",
          "rewashRequestedAtMs",
          "rewashRequestedBy",
          "priorityType",
          "isRewashCycle",
          "needByAtMs",
          "needBySetBy",
          "ro",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields",
          "events"
        ]);

      allow update: if isAdvisor()
        && onlyChanges([
          "cpBookedAt",
          "cpBookedBy",
          "qcRequestedAt",
          "qcRequestedBy",
          "qcAssignedTo",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);

      allow update: if isBooker()
        && onlyChanges([
          "cpBookedAt",
          "cpBookedBy",
          "wtyBookedAt",
          "wtyBookedBy",
          "qcRequestedAt",
          "qcRequestedBy",
          "qcAssignedTo",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);

      allow update: if isQc()
        && resource.data.qcAssignedTo == request.auth.uid
        && onlyChanges([
          "qcDoneAt",
          "qcDoneBy",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);

      allow delete: if isAdmin() || isManager();
    }

    /* ---------------------------------------
       SETTINGS COLLECTION
    --------------------------------------- */

    match /settings/{docId} {
      allow read: if isEmployee();
      allow write: if canControlWashDay();
    }

    /* ---------------------------------------
      PRIVATE SETTINGS
    --------------------------------------- */

    match /privateSettings/{docId} {
      allow read, write: if signedIn();
    }

    /* ---------------------------------------
       ACTIVE ROS (temporary test access)
    --------------------------------------- */

    match /activeROs/{roId} {
      allow read, write: if true;
    }

    /* ---------------------------------------
       ARROWDEV USERS
    --------------------------------------- */

    match /arrowdevUsers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isArrowDev();
      allow create, update, delete: if false;
    }

    /* ---------------------------------------
       INTEGRATIONS
    --------------------------------------- */

    match /integrations/{integrationId} {
      allow read, write: if isArrowDev();
    }

    /* ---------------------------------------
       INTEGRATION LOGS
    --------------------------------------- */

    match /integrationLogs/{logId} {
      allow read, write: if isArrowDev();
    }

    /* ---------------------------------------
       ROS COLLECTION
    --------------------------------------- */

    match /ros/{roId} {

      allow read: if isEmployee();

      allow create: if isAdmin() || isManager() || isAdvisor() || isBooker();

      allow update, delete: if isAdmin() || isManager();

      allow update: if (isAdvisor() || isBooker())
        && onlyChanges([
          "customerName",
          "phone",
          "tag",
          "roDate",
          "promiseDate",
          "model",
          "concern",
          "status",
          "notes",
          "techVideo",
          "readyCalled",
          "calledAtMs",
          "nextUpdateAtMs",
          "customerWaiting",
          "hasLoaner",
          "advisor",
          "source",
          "updatedAt"
        ]);

      allow update: if canFixTag()
        && onlyChanges([
          "tag",
          "updatedAt"
        ]);

      allow update: if canFixRo()
        && onlyChanges([
          "ro",
          "updatedAt"
        ]);

      allow delete: if canFixRo();
    }

    /* ---------------------------------------
       FOLLOWUP / ARCHIVE COLLECTION
    --------------------------------------- */

    match /followup/{roId} {
      allow read: if isEmployee();

      allow create: if isAdmin() || isManager() || isAdvisor() || isBooker();

      allow update, delete: if isAdmin() || isManager() || isAdvisor() || isBooker();
    }

    /* ---------------------------------------
        MASTER ARCHIVE
    --------------------------------------- */

    match /tickets_archive/{roId} {
      allow read: if isEmployee();

      allow create: if isAdmin() || isManager() || isAdvisor() || isBooker();

      allow update, delete: if isAdmin() || isManager();
    }

    /* ---------------------------------------
       DEFAULT DENY
    --------------------------------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
