rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------
       AUTH HELPERS
    --------------------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function isActive() {
      return userDoc().data.active == true;
    }

    function isAdmin() {
      return signedIn() && isActive() && role() == "admin";
    }

    function isManager() {
      return signedIn() && isActive() && role() == "manager";
    }

    function isAdvisor() {
      return signedIn() && isActive() && role() == "advisor";
    }

    function isWash() {
      return signedIn() && isActive() && role() == "wash";
    }

    // Keep BOTH to avoid breaking older calls
    function isstaff() {
      return signedIn() && isActive() && role() == "staff";
    }
    function isStaff() {
      return isstaff();
    }

    function isBooker() {
      return signedIn() && isActive() && role() == "booker";
    }

    function isQc() {
      return signedIn() && isActive() && role() == "qc";
    }

    function isValet() {
      return signedIn() && isActive() && role() == "valet";
    }

    // Any approved internal user
    function isEmployee() {
      return isAdmin()
        || isManager()
        || isAdvisor()
        || isWash()
        || isStaff()
        || isValet()
        || isBooker()
        || isQc();
    }

    function onlyChanges(allowedKeys) {
      return request.resource.data
        .diff(resource.data)
        .changedKeys()
        .hasOnly(allowedKeys);
    }

    // supervisors can control wash day/settings
    function canControlWashDay() {
      return isAdmin()
        || isManager()
        || (signedIn() && isActive() && userDoc().data.permissions.canControlWashDay == true);
    }

    // --- Corrections permission helpers (per-user, admin-managed) ---
    function canEditTickets() {
      return signedIn()
        && isActive()
        && userDoc().data.permissions.canEditTickets == true;
    }

    function canFixTag() {
      return canEditTickets()
        && userDoc().data.permissions.corrections.tag == true;
    }

    function canFixRo() {
      return canEditTickets()
        && userDoc().data.permissions.corrections.ro == true;
    }

    function canFixLocation() {
      return canEditTickets()
        && userDoc().data.permissions.corrections.location == true;
    }

    function canFixAdvisorNumber() {
      return canEditTickets()
        && userDoc().data.permissions.corrections.advisorNumber == true;
    }

    function auditKeys() {
      // note: Firestore rules can't return arrays, so we inline audit sets per rule
      return true;
    }

    /* ---------------------------------------
       USERS COLLECTION
    --------------------------------------- */

    match /users/{uid} {

      allow list: if isAdmin() || isManager() || isBooker();

      allow get: if
        (signedIn() && request.auth.uid == uid)
        || isAdmin()
        || isManager();

      allow create: if
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == "pending"
        && request.resource.data.active == true;

      // user can update own non-role/non-active fields only (strict)
      allow update: if
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active;

      // manager can assign roles (NOT admin)
      allow update: if
        isManager()
        && uid != request.auth.uid
        && request.resource.data.role in [
          "manager",
          "advisor",
          "wash",
          "staff",
          "valet",
          "booker",
          "qc",
          "pending"
        ]
        && request.resource.data.role != "admin";

      // admin/manager can set permissions (expanded)
      allow update: if
        (isAdmin() || isManager())
        && uid != request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["permissions", "updatedAt"])
        && request.resource.data.permissions is map
        && request.resource.data.permissions.keys().hasOnly([
          "canControlWashDay",
          "canEditTickets",
          "corrections"
        ])
        && request.resource.data.permissions.canControlWashDay is bool
        && request.resource.data.permissions.canEditTickets is bool
        && request.resource.data.permissions.corrections is map
        && request.resource.data.permissions.corrections.keys().hasOnly([
          "tag",
          "ro",
          "location",
          "advisorNumber"
        ])
        && request.resource.data.permissions.corrections.tag is bool
        && request.resource.data.permissions.corrections.ro is bool
        && request.resource.data.permissions.corrections.location is bool
        && request.resource.data.permissions.corrections.advisorNumber is bool;

      allow update: if isAdmin();

      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    /* ---------------------------------------
       WASH TICKETS COLLECTION
    --------------------------------------- */

    match /washTickets/{ticketId} {

      /* READ */
      allow read: if isEmployee();

      /* CREATE */
      allow create: if isEmployee();

      /* UPDATE */

      // Admin / Manager: full control
      allow update: if isAdmin() || isManager();

      // ---------------------------------------------------------
      // CORRECTIONS (per-user + per-field)
      // One-field-at-a-time edits ONLY (matches your button flow)
      // ---------------------------------------------------------

      // Fix Tag
      allow update: if canFixTag()
        && onlyChanges([
          "tag",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ]);

      // Fix RO
      allow update: if canFixRo()
        && onlyChanges([
          "ro",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ]);

      // Fix Location
      allow update: if canFixLocation()
        && onlyChanges([
          "location",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ]);

      // Fix Advisor #
      allow update: if canFixAdvisorNumber()
        && onlyChanges([
          "advisorNumber",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ]);

      // ---------------------------------------------------------
      // WASH ROLE: washing workflow
      // ---------------------------------------------------------
      allow update: if isWash()
        && onlyChanges([
          // status workflow
          "status",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",

          // wash start fields
          "washingStartedAt",
          "washingStartedAtMs",
          "washingStartedBy",

          // wash complete fields
          "washedAt",
          "washedAtMs",
          "washedBy",

          // counters / rewash state
          "washCount",
          "rewashCount",
          "priorityType",
          "isRewashCycle",
          "rewashRequestedAtMs",
          "rewashRequestedBy",

          // audit
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields",

          // event log
          "events",

          // scheduler fields
          "scheduledAtMs",
          "scheduledEndAtMs",
          "scheduledBay",
          "scheduleRisk",
          "scheduleUpdatedAtMs"
        ]);

      // ---------------------------------------------------------
      // ADVISOR: Need By + RO edit
      // ---------------------------------------------------------
      allow update: if isAdvisor()
        && onlyChanges([
          "priorityType",
          "needByAtMs",
          "needBySetBy",
          "ro",

          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",

          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);

      // ---------------------------------------------------------
      // ADVISOR: REWASH REQUEST
      // ---------------------------------------------------------
      allow update: if isAdvisor()
        && resource.data.status == "washed"
        && request.resource.data.status == "queued"
        && request.resource.data.rewashRequestedBy == request.auth.uid
        && request.resource.data.rewashRequestedAtMs is int
        && request.resource.data.priorityType == "rewash"
        && request.resource.data.isRewashCycle == true
        && onlyChanges([
          "status",

          "rewashRequestedAtMs",
          "rewashRequestedBy",

          "priorityType",
          "isRewashCycle",

          // optional: advisor may also set need-by for the rewash
          "needByAtMs",
          "needBySetBy",

          // optional: RO field
          "ro",

          // audit + events
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",

          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields",
          "events"
        ]);

      // ---------------------------------------------------------
      // ADVISOR: request/assign QC + CP booked stamps
      // ---------------------------------------------------------
      allow update: if isAdvisor()
        && onlyChanges([
          "cpBookedAt",
          "cpBookedBy",
          "qcRequestedAt",
          "qcRequestedBy",
          "qcAssignedTo",

          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",

          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);

      // ---------------------------------------------------------
      // BOOKER: CP / WTY booked + QC assign/request
      // ---------------------------------------------------------
      allow update: if isBooker()
        && onlyChanges([
          "cpBookedAt",
          "cpBookedBy",
          "wtyBookedAt",
          "wtyBookedBy",
          "qcRequestedAt",
          "qcRequestedBy",
          "qcAssignedTo",

          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",

          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);

      // ---------------------------------------------------------
      // QC: mark QC complete ONLY if assigned
      // ---------------------------------------------------------
      allow update: if isQc()
        && resource.data.qcAssignedTo == request.auth.uid
        && onlyChanges([
          "qcDoneAt",
          "qcDoneBy",

          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",

          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);

      /* DELETE */
      allow delete: if isAdmin() || isManager();
    }

    /* ---------------------------------------
       SETTINGS COLLECTION
    --------------------------------------- */

    match /settings/{docId} {
      allow read: if isEmployee();
      allow write: if canControlWashDay();
    }

    /* ---------------------------------------
       DEFAULT DENY
    --------------------------------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}