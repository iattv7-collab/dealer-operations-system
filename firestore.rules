rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------
       AUTH HELPERS
    --------------------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function isActive() {
      return userDoc().data.active == true;
    }

    function isAdmin() {
      return signedIn() && isActive() && role() == "admin";
    }

    function isManager() {
      return signedIn() && isActive() && role() == "manager";
    }

    function isAdvisor() {
      return signedIn() && isActive() && role() == "advisor";
    }

    function isWash() {
      return signedIn() && isActive() && role() == "wash";
    }

    function isstaff() {
      return signedIn() && isActive() && role() == "staff";
    }

    function isBooker() {
      return signedIn() && isActive() && role() == "booker";
    }

    function isQc() {
      return signedIn() && isActive() && role() == "qc";
    }

    function isStaff() {
      return isAdmin()
        || isManager()
        || isAdvisor()
        || isWash()
        || isstaff()
        || isBooker()
        || isQc();
    }

    function onlyChanges(allowedKeys) {
      return request.resource.data
        .diff(resource.data)
        .changedKeys()
        .hasOnly(allowedKeys);
    }


    /* ---------------------------------------
       USERS COLLECTION
    --------------------------------------- */

    match /users/{uid} {

      allow list: if isAdmin() || isManager() || isBooker();

      allow get: if
        (signedIn() && request.auth.uid == uid)
        || isAdmin()
        || isManager();

      allow create: if
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == "pending"
        && request.resource.data.active == true;

      allow update: if
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active;

      // manager can assign roles (including booker and qc)
      allow update: if
        isManager()
        && uid != request.auth.uid
        && request.resource.data.role in [
          "manager",
          "advisor",
          "wash",
          "staff",
          "booker",
          "qc",
          "pending"
        ]
        && request.resource.data.role != "admin";

      allow update: if isAdmin();

      allow delete: if isAdmin()
        && uid != request.auth.uid;
    }


    /* ---------------------------------------
       WASH TICKETS COLLECTION
    --------------------------------------- */

    match /washTickets/{ticketId} {

      /* READ */

      allow read: if isStaff();


      /* CREATE */

      allow create: if isStaff();


      /* UPDATE */

      // Admin / Manager: full control
      allow update: if isAdmin() || isManager();


      // Wash role: washing workflow only
      allow update: if isWash()
        && onlyChanges([
          "status",
          "washedAt",
          "washedBy",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);


      // Advisor: Need By + RO edit
      allow update: if isAdvisor()
        && onlyChanges([
          "priorityType",
          "needByAtMs",
          "needBySetBy",
          "ro",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);


      // Advisor: REWASH workflow
      allow update: if isAdvisor()
        && resource.data.status == "washed"
        && request.resource.data.status == "washing"
        && request.resource.data.rewashRequestedBy == request.auth.uid
        && request.resource.data.rewashRequestedAtMs is int
        && request.resource.data.priorityType == "rewash"
        && onlyChanges([
          "status",
          "rewashRequestedAtMs",
          "rewashRequestedBy",
          "priorityType",
          "needByAtMs",
          "needBySetBy",
          "ro",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);

      // Advisor can also request/assign QC (+ audit fields)
      allow update: if isAdvisor()
        && onlyChanges([
          "cpBookedAt",
          "cpBookedBy",
          "qcRequestedAt",
          "qcRequestedBy",
          "qcAssignedTo",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);



      // BOOKER: CP / WTY booked + QC assign/request
      allow update: if isBooker()
        && onlyChanges([
          "cpBookedAt",
          "cpBookedBy",
          "wtyBookedAt",
          "wtyBookedBy",
          "qcRequestedAt",
          "qcRequestedBy",
          "qcAssignedTo",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);


      // QC: mark QC complete ONLY if assigned
      allow update: if isQc()
        && resource.data.qcAssignedTo == request.auth.uid
        && onlyChanges([
          "qcDoneAt",
          "qcDoneBy",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);


      /* DELETE */

      allow delete: if isAdmin() || isManager();

    }


    /* ---------------------------------------
       SETTINGS COLLECTION
    --------------------------------------- */

    match /settings/{docId} {

      allow read: if isStaff();

      allow write: if isAdmin() || isManager();

    }


    /* ---------------------------------------
       DEFAULT DENY
    --------------------------------------- */

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
