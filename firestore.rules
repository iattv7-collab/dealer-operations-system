rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------
       AUTH HELPERS
    --------------------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function isActive() {
      return userDoc().data.active == true;
    }

    function isAdmin() {
      return signedIn() && isActive() && role() == "admin";
    }

    function isManager() {
      return signedIn() && isActive() && role() == "manager";
    }

    function isAdvisor() {
      return signedIn() && isActive() && role() == "advisor";
    }

    function isWash() {
      return signedIn() && isActive() && role() == "wash";
    }

    // NOTE: you had both isstaff() and isStaff(). Keeping both to avoid breaking anything.
    function isstaff() {
      return signedIn() && isActive() && role() == "staff";
    }

    function isBooker() {
      return signedIn() && isActive() && role() == "booker";
    }

    function isQc() {
      return signedIn() && isActive() && role() == "qc";
    }

    function isStaff() {
      return isAdmin()
        || isManager()
        || isAdvisor()
        || isWash()
        || isstaff()
        || isBooker()
        || isQc();
    }

    function onlyChanges(allowedKeys) {
      return request.resource.data
        .diff(resource.data)
        .changedKeys()
        .hasOnly(allowedKeys);
    }

    /* ---------------------------------------
       USERS COLLECTION
    --------------------------------------- */

    match /users/{uid} {

      allow list: if isAdmin() || isManager() || isBooker();

      allow get: if
        (signedIn() && request.auth.uid == uid)
        || isAdmin()
        || isManager();

      allow create: if
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == "pending"
        && request.resource.data.active == true;

      allow update: if
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active;

      // manager can assign roles (including booker and qc)
      allow update: if
        isManager()
        && uid != request.auth.uid
        && request.resource.data.role in [
          "manager",
          "advisor",
          "wash",
          "staff",
          "booker",
          "qc",
          "pending"
        ]
        && request.resource.data.role != "admin";

      allow update: if isAdmin();

      allow delete: if isAdmin()
        && uid != request.auth.uid;
    }

    /* ---------------------------------------
       WASH TICKETS COLLECTION
    --------------------------------------- */

    match /washTickets/{ticketId} {

      /* READ */
      allow read: if isStaff();

      /* CREATE */
      allow create: if isStaff();

      /* UPDATE */

      // Admin / Manager: full control
      allow update: if isAdmin() || isManager();

      // ---------------------------------------------------------
      // WASH ROLE: washing workflow (expanded to match your model)
      // ---------------------------------------------------------
      allow update: if isWash()
        && onlyChanges([
          // status workflow
          "status",
          "updatedAt",

          // wash start fields
          "washingStartedAt",
          "washingStartedAtMs",
          "washingStartedBy",

          // wash complete fields
          "washedAt",
          "washedAtMs",
          "washedBy",

          // counters / rewash state
          "washCount",
          "rewashCount",
          "priorityType",
          "isRewashCycle",
          "rewashRequestedAtMs",
          "rewashRequestedBy",

          // audit
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields",

          // event log
          "events",

          "scheduledAtMs",
          "scheduledEndAtMs",
          "scheduledBay",
          "scheduleRisk",
          "scheduleUpdatedAtMs"
        ]);

      // ---------------------------------------------------------
      // ADVISOR: Need By + RO edit (as before)
      // ---------------------------------------------------------
      allow update: if isAdvisor()
        && onlyChanges([
          "priorityType",
          "needByAtMs",
          "needBySetBy",
          "ro",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);

      // ---------------------------------------------------------
      // ADVISOR: REWASH REQUEST (FIXED)
      // Your UI moves washed -> queued (Active), not washed -> washing
      // Also allows events + isRewashCycle that requestRewash() writes
      // ---------------------------------------------------------
      allow update: if isAdvisor()
        && resource.data.status == "washed"
        && request.resource.data.status == "queued"
        && request.resource.data.rewashRequestedBy == request.auth.uid
        && request.resource.data.rewashRequestedAtMs is int
        && request.resource.data.priorityType == "rewash"
        && request.resource.data.isRewashCycle == true
        && onlyChanges([
          "status",

          "rewashRequestedAtMs",
          "rewashRequestedBy",

          "priorityType",
          "isRewashCycle",

          // optional: advisor may also set need-by for the rewash
          "needByAtMs",
          "needBySetBy",

          // optional: RO field
          "ro",

          // audit + events
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields",
          "events"
        ]);

      // ---------------------------------------------------------
      // Advisor can also request/assign QC (+ audit fields)
      // ---------------------------------------------------------
      allow update: if isAdvisor()
        && onlyChanges([
          "cpBookedAt",
          "cpBookedBy",
          "qcRequestedAt",
          "qcRequestedBy",
          "qcAssignedTo",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);

      // ---------------------------------------------------------
      // BOOKER: CP / WTY booked + QC assign/request
      // ---------------------------------------------------------
      allow update: if isBooker()
        && onlyChanges([
          "cpBookedAt",
          "cpBookedBy",
          "wtyBookedAt",
          "wtyBookedBy",
          "qcRequestedAt",
          "qcRequestedBy",
          "qcAssignedTo",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);

      // ---------------------------------------------------------
      // QC: mark QC complete ONLY if assigned
      // ---------------------------------------------------------
      allow update: if isQc()
        && resource.data.qcAssignedTo == request.auth.uid
        && onlyChanges([
          "qcDoneAt",
          "qcDoneBy",
          "updatedAt",
          "lastEditedAtMs",
          "lastEditedBy",
          "lastEditedRole",
          "lastEditedFields"
        ]);

      /* DELETE */
      allow delete: if isAdmin() || isManager();
    }

    /* ---------------------------------------
       SETTINGS COLLECTION
    --------------------------------------- */

    match /settings/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin() || isManager();
    }

    /* ---------------------------------------
       DEFAULT DENY
    --------------------------------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
